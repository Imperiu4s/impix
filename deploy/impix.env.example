# Példa a /etc/impix.env fájlhoz (az install.sh létrehozza; jogosultság: 600, tulajdonos: root)
PORT=3000
TRUST_PROXY=1

# Adatbázis, feltöltött videók és a media.key ebbe a mappába kerülnek (a szolgáltatás StateDirectory-ja)
IMPIX_DB=/var/lib/impix/impix.db

# Melyik oldalakról hívható az API (csak eredet, útvonal nélkül).
CORS_ORIGINS=https://www.impix.hu,https://impix.hu,https://imperiu4s.github.io

# Az admin fiók csak az ELSŐ indításkor jön létre ezekből. Utána törölheted a két sort.
ADMIN_EMAIL=te@example.com
ADMIN_PASSWORD=ide-egy-eros-jelszo

# Opcionális: legnagyobb feltölthető videó MB-ban (alap: 2048)
# MAX_UPLOAD_MB=2048
