# Másold .env néven a server.js mellé, és töltsd ki. (A .env fájlt ne tedd GitHubra!)
# A fájl sorai: NÉV=érték. A # sorok megjegyzések.

# Ha nem adod meg, a szerver a SERVER_PORT (Pterodactyl) vagy a 3000-es portot használja
# PORT=3000

# Reverse proxy (nginx) mögött kötelező
TRUST_PROXY=1

# Melyik weboldalakról hívható az API (csak eredet, útvonal nélkül, vesszővel elválasztva)
CORS_ORIGINS=https://impix.hu,https://www.impix.hu,https://imperiu4s.github.io

# Az admin fiók csak az ELSŐ indításkor jön létre ezekből. Utána törölheted a két sort.
ADMIN_EMAIL=te@example.com
ADMIN_PASSWORD=ide-egy-eros-jelszo

# Bankkártyás fizetés (Stripe), részletek: STRIPE.md
# STRIPE_SECRET_KEY=sk_test_...        (éles oldalon sk_live_...)
# STRIPE_WEBHOOK_SECRET=whsec_...
# A weboldal címe (záró perjel nélkül): ide tér vissza a felhasználó a fizetés után
SITE_URL=https://impix.hu
# CSAK teszteléshez: ingyenes előfizetés Stripe nélkül. ÉLESEN NE KAPCSOLD BE!
# DEMO_PAYMENTS=1

# Szolgáltatói (cég)adatok: az ÁSZF, az Adatkezelési tájékoztató, az Impresszum és a számlák ezekből töltődnek ki.
# NEM KELL ide kitölteni: az adatokat az admin panel "Cégadatok" fülén add meg (az adatbázisba mentődnek).
# Az alábbi változók csak tartalékként szolgálnak, ha az admin panelen valami üresen maradt. Egyeztess a könyvelőddel!
# SELLER_NAME=Az Ön neve vagy cégneve
# SELLER_ADDRESS=1111 Budapest, Példa utca 1.
# SELLER_TAX_ID=12345678-1-42
# SELLER_EMAIL=info@impix.hu
# SELLER_PHONE=+36 30 123 4567
# SELLER_REG_NUMBER=01-09-123456
# SELLER_REG_LABEL=cégjegyzékszám
# HOSTING_NAME=Tárhelyszolgáltató Kft.
# HOSTING_ADDRESS=1111 Budapest, Példa tér 2.
# HOSTING_EMAIL=info@tarhely.example
# ÁFA kulcs %-ban a bruttó árból számolva (alap: 27). Alanyi adómentesség esetén 0:
# SELLER_VAT_RATE=0
# SELLER_VAT_NOTE=Alanyi adómentes
# A számlák sorszámának előtagja (alap: IMPIX), pl. IMPIX-2026-000001 (csak innen állítható)
# INVOICE_PREFIX=IMPIX
# Automatikus értékelés (AI): az Anthropic API kulcsot az admin panel "Cégadatok" fülén is megadhatod (nem kell ide)
# ANTHROPIC_API_KEY=sk-ant-...

# HTTPS: ha a szerver mellett van tls/fullchain.pem és tls/privkey.pem, a szerver maga szolgál ki HTTPS-t
# (lásd DEPLOY-PTERODACTYL.md). Más helyre mutató fájlokhoz:
# TLS_CERT=/utvonal/fullchain.pem
# TLS_KEY=/utvonal/privkey.pem

# Opcionális: legnagyobb feltölthető videó MB-ban (alap: 2048)
# MAX_UPLOAD_MB=2048
